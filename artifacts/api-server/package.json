{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development TZ=America/Sao_Paulo tsx --env-file=../../.env ./src/index.ts",
    "build": "tsx ./build.ts",
    "start": "cd ../../lib/db && drizzle-kit push --force --config ./drizzle.config.ts && cd ../../artifacts/api-server && node dist/index.cjs",
    "start-only": "cross-env TZ=America/Sao_Paulo node dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:free-shipping": "node --test --import tsx ./src/lib/free-shipping.test.ts ./src/lib/motoboy-eligible-products.test.ts ./src/lib/motoboy-neighborhood-normalize.test.ts ./src/lib/motoboy-cep-range-pick.test.ts ./src/lib/motoboy-distance.test.ts ./src/lib/motoboy-slot-hours.test.ts ./src/lib/motoboy-geocode.test.ts ./src/lib/motoboy-route.test.ts ./src/lib/motoboy-yury-hmac.test.ts ./src/lib/yury-inventory.test.ts ./src/lib/pix-gateway-credentials.test.ts ./src/lib/order-shipments-logic.test.ts ./src/lib/affiliate-seller-customer.test.ts",
    "test:insurance": "node --test --import tsx ./src/lib/checkout-insurance.test.ts ./src/lib/insurance-claims-policy.test.ts",
    "test:envioecom": "node --test --import tsx ./src/lib/shipping-control-tower.test.ts ./src/lib/shipment-label-filename.test.ts ./src/lib/carrier-loss.test.ts ./src/lib/loss-peer.test.ts ./src/lib/carrier-delivery-hint.test.ts",
    "test:meta-ads": "node --test --import tsx ./src/lib/meta-ads-spend.test.ts",
    "test:pix-settlement": "node --test --import tsx ./src/lib/pix-settlement.test.ts ./src/lib/pix-charge-proof-core.test.ts",
    "test:pix-webhook-local": "node --test --import tsx ./src/routes/pix-webhook.integration.test.ts",
    "test:admin-permissions-local": "node --test --import tsx ./src/routes/admin-permissions.integration.test.ts",
    "test:admin-seller-scope": "node --test --import tsx ./src/lib/admin-seller-scope-core.test.ts ./src/lib/order-events.test.ts",
    "test:admin-seller-scope-local": "node --test --import tsx ./src/routes/admin-seller-scope.integration.test.ts",
    "test:admin-tenant": "node --test --import tsx ./src/lib/admin-tenant-pick.test.ts ./src/lib/tenant-store-scope.test.ts ./src/lib/tenant-product-sync.test.ts ./src/lib/tenant-context.test.ts",
    "test:site-release": "node --test --import tsx ./src/lib/site-release.test.ts",
    "test:shipping-channel": "node --test --import tsx ./src/lib/shipping-via.test.ts",
    "test:shipping-channel-local": "node --test --import tsx ./src/routes/shipping-channel.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.916.0",
    "@workspace/db": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-kit": "^0.31.9",
    "express": "^5",
    "cookie-parser": "^1.4.7",
    "cors": "^2"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.10",
    "esbuild": "^0.27.3",
    "tsx": "catalog:"
  }
}